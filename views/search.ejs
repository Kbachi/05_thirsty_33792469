<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Search - <%= shopName %></title>
  </head>
  <body>
    <h1>Search in <%= shopName %></h1>
    <h2>Search Products</h2>
    <form action="/search_result" method="GET">
      <label for="search_box">Product Name:</label>
      <input id="search_box" type="text" name="search_text"><br><br>
      
      <label for="category">Category:</label>
      <input id="category" type="text" name="category"><br><br>
      
      <input type="submit" value="OK">
    </form>
    <p><a href="/">Home</a> | <a href="/about">About</a></p>
  </body>
</html>